# Copy this file to .env and fill in real values. Do NOT commit .env.

# Neon / PostgreSQL connection string (required)
DATABASE_URL=

# OpenAI API key for the AI word-explanation endpoint (/api/explain-word).
# Without it the app still builds and runs; only word explanation returns a 503.
OPENAI_KEY=

# Secret for signing JWT session cookies. Must be at least 32 characters.
# In development a fallback dev secret is used if this is missing.
JWT_SECRET=

# Web Push (VAPID) keys. Generate with:  npx web-push generate-vapid-keys
# Public key is exposed to the browser (NEXT_PUBLIC_ prefix is required).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for push (e.g. mailto:you@example.com). Defaults to a placeholder if unset.
VAPID_SUBJECT=
